{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuri-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Le dashboard (build Vite) est servi directement par Cloudflare ; seul /api/* réveille le Worker.
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Serveur Dokploy (ou autre) qui fait tourner apps/api. Changer d'hébergeur = changer cette ligne.
    "API_ORIGIN": "https://api-origin.example.com"
  }
  // Secret partagé avec l'API : `wrangler secret put EDGE_SECRET` (même valeur que EDGE_SECRET côté API).
  // Activé au premier déploiement : "routes": [{ "pattern": "app.zurisell.store", "custom_domain": true }]
}
