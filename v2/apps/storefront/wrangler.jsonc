{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuri-storefront",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "assets": { "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    // Serveur qui fait tourner apps/api (même valeur que pour apps/edge).
    "API_ORIGIN": "https://api-origin.zurisell.store",
    // Domaine « plateforme » : /:slug, /:slug/p/:id, /:slug/order/:token.
    "PLATFORM_HOST": "zurisell.store",
    // Sous-domaines boutiques : <sous-domaine>.BASE_DOMAIN (même valeur que BASE_DOMAIN côté API).
    "BASE_DOMAIN": "zurisell.store"
    // Optionnel : "IMAGE_RESIZING": "cloudflare" si Image Resizing est activé sur la zone (/cdn-cgi/image).
  }
  // Secret partagé avec l'API : `wrangler secret put EDGE_SECRET` (même valeur que EDGE_SECRET côté API).
  ,"routes": [
    { "pattern": "zurisell.store", "custom_domain": true },
    // Sous-domaines boutiques. app.zurisell.store (domaine personnalisé du Worker zuri-app) reste prioritaire,
    // api-origin.zurisell.store n'est pas proxifié (nuage gris) donc non concerné.
    { "pattern": "*.zurisell.store/*", "zone_name": "zurisell.store" }
  ]
  // Domaines personnalisés des vendeurs : Cloudflare for SaaS (custom hostnames) pointant vers ce Worker.
}
