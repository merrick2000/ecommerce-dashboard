---
import type { Lang, Source } from '../../content/seo'

interface Props {
  sources: Source[]
  lang: Lang
}
const { sources, lang } = Astro.props
---

{
  sources.length > 0 && (
    <section class="mk-sources">
      <p class="mk-sources-title">{lang === 'fr' ? 'Sources' : 'Sources'}</p>
      <ul>
        {sources.map((s) => (
          <li>
            <a href={s.url} rel="nofollow noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
