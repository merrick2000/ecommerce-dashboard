---
/** Bandeau d'offre de lancement en haut des pages marketing. */
import Countdown from './Countdown.astro'
import { OFFER, offerActive } from '../../../content/seo/offer'
import type { Lang } from '../../../content/seo'
interface Props {
  lang: Lang
  href: string
}
const { lang, href } = Astro.props
const o = OFFER[lang]
---

{
  offerActive() && (
    <a class="mk-promo" href={href}>
      <span class="mk-promo-text">{o.short}</span>
      <span class="mk-promo-cd">
        {o.left} <Countdown lang={lang} />
      </span>
      <span class="mk-promo-cta">{o.cta}</span>
    </a>
  )
}
