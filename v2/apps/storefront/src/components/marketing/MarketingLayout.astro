---
/**
 * Gabarit du site marketing Zuri (accueil, pays, guides, alternatives, comparatifs), en français et en anglais.
 * Zéro police externe, zéro JavaScript : la page charge instantanément, même en 3G.
 */
import '../../styles/marketing.css'
import { env } from 'cloudflare:workers'
import { COUNTRIES, GUIDES, PATHS, countryPath, guidePath, t } from '../../content/seo'
import type { Lang } from '../../content/seo'
import PromoBar from './offer/PromoBar.astro'
import Icon from './Icon.astro'
import { contactInfo, waLink } from '../../lib/contact'

interface Crumb {
  label: string
  href?: string
}

interface Props {
  title: string
  description: string
  canonicalPath: string
  lang?: Lang
  /** Chemin de la même page dans l'autre langue (balises hreflang et lien de langue). */
  alternate?: { fr?: string; en?: string }
  /** Données structurées schema.org (une ou plusieurs). */
  jsonLd?: Record<string, unknown>[]
  breadcrumbs?: Crumb[]
  /** Chemin de l'image de partage 1200×630 (JPEG). */
  ogImage?: string
  ogImageAlt?: string
}

const { title, description, canonicalPath, lang = 'fr', alternate = {}, jsonLd = [], breadcrumbs = [], ogImage, ogImageAlt } = Astro.props
const base = `https://${env.PLATFORM_HOST && env.PLATFORM_HOST !== 'localhost' ? env.PLATFORM_HOST : 'zurisell.store'}`
const abs = (p: string) => new URL(p, base).toString()
const canonical = abs(canonicalPath)
const appOrigin = import.meta.env.DEV ? 'http://localhost:5173' : (env.APP_ORIGIN ?? `https://app.${env.BASE_DOMAIN ?? 'zurisell.store'}`)
const signupUrl = `${appOrigin}/register`
const loginUrl = `${appOrigin}/login`
const home = PATHS.home[lang]
const other: Lang = lang === 'fr' ? 'en' : 'fr'
const otherPath = alternate[other] ?? PATHS.home[other]

const T = {
  fr: { how: 'Comment ça marche', features: 'Fonctionnalités', pricing: 'Tarifs', about: 'À propos', faq: 'Questions', login: 'Se connecter', signup: 'Créer ma boutique', skip: 'Aller au contenu', tagline: 'La boutique en ligne pensée pour le paiement à la livraison et le Mobile Money, en Afrique.', product: 'Produit', resources: 'Ressources', countries: 'Vendre par pays', guides: 'Guides', tools: 'Outils gratuits', cities: 'Vendre par ville', niches: 'Vendre par métier', best: 'Meilleurs outils', alternatives: 'Alternatives', compare: 'Comparatifs', account: 'Compte', popular: 'Guides populaires', bottom: 'Fait pour les vendeurs d’Afrique.', home: 'Accueil', langLabel: 'English', allCountries: 'Tous les pays', contact: 'Contact', help: 'Aide', featuresPage: 'Fonctionnalités', changelog: 'Nouveautés', waFloat: 'Une question ?', waMsg: 'Bonjour Zuri, j’ai une question : ' },
  en: { how: 'How it works', features: 'Features', pricing: 'Pricing', about: 'About', faq: 'FAQ', login: 'Log in', signup: 'Create my store', skip: 'Skip to content', tagline: 'The online store built for cash on delivery and Mobile Money, in Africa.', product: 'Product', resources: 'Resources', countries: 'Sell by country', guides: 'Guides', tools: 'Free tools', cities: 'Sell by city', niches: 'Sell by category', best: 'Best tools', alternatives: 'Alternatives', compare: 'Comparisons', account: 'Account', popular: 'Popular guides', bottom: 'Built for sellers across Africa.', home: 'Home', langLabel: 'Français', allCountries: 'All countries', contact: 'Contact', help: 'Help', featuresPage: 'Features', changelog: 'Changelog', waFloat: 'Questions?', waMsg: 'Hello Zuri, I have a question: ' },
}[lang]

// Pied de page : liens internes vers les pages les plus utiles (maillage SEO).
const footerCountries = COUNTRIES.filter((c) => (lang === 'fr' ? c.primaryLang === 'fr' && c.region !== 'diaspora' : c.primaryLang === 'en')).slice(0, 8)
const footerGuides = GUIDES.slice(0, 6)
const contact = await contactInfo()
const contactPath = lang === 'fr' ? '/contact' : '/en/contact'

const crumbsLd = breadcrumbs.length
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ label: T.home, href: home }, ...breadcrumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href ? { item: abs(c.href) } : {}) })),
      },
    ]
  : []

// Accueil : identité de la marque (Organization + WebSite), référencée par les autres données structurées.
const orgLd =
  canonicalPath === home
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Organization',
          '@id': 'https://zurisell.store/#organization',
          name: 'Zuri',
          alternateName: ['Zuri (zurisell.store)', 'zurisell.store'],
          url: 'https://zurisell.store/',
          logo: 'https://zurisell.store/og/fr/hub/home.jpg',
          description: T.tagline,
          areaServed: 'Africa',
          knowsLanguage: ['fr', 'en'],
          email: contact.email,
          contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer support', email: contact.email, ...(contact.whatsapp ? { telephone: contact.whatsapp } : {}), availableLanguage: ['French', 'English'], url: `https://zurisell.store${contactPath}` }],
          ...(contact.socials?.length ? { sameAs: contact.socials } : {}),
        },
        { '@context': 'https://schema.org', '@type': 'WebSite', '@id': 'https://zurisell.store/#website', name: 'Zuri', url: 'https://zurisell.store/', inLanguage: ['fr', 'en'], publisher: { '@id': 'https://zurisell.store/#organization' } },
      ]
    : []

// Page marketing : publique, mise en cache en périphérie.
const cache = 'public, s-maxage=600, stale-while-revalidate=86400'
Astro.response.headers.set('Cache-Control', cache)
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', cache)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate.fr && <link rel="alternate" hreflang="fr" href={abs(alternate.fr)} />}
    {alternate.en && <link rel="alternate" hreflang="en" href={abs(alternate.en)} />}
    {alternate.fr && <link rel="alternate" hreflang="x-default" href={abs(alternate.fr)} />}
    <meta name="theme-color" content="#f59e0b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zuri" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={abs(ogImage)} />
          <meta property="og:image:secure_url" content={abs(ogImage)} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={ogImageAlt ?? title} />
          <meta name="twitter:image" content={abs(ogImage)} />
          <meta name="twitter:image:alt" content={ogImageAlt ?? title} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23f59e0b'/%3E%3Cpath d='M10.5 10.5h11l-11 11h11' fill='none' stroke='%231c1917' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    {[...orgLd, ...jsonLd, ...crumbsLd].map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <script defer src="https://cloud.umami.is/script.js" data-website-id="2ed31424-94e4-42f7-96bb-bb2ef20f6418" data-domains="zurisell.store"></script>
    <script is:inline>
      /* Provenance du visiteur (premier contact), lue à l'inscription sur app.zurisell.store. Aucune donnée personnelle. */
      try {
        if (location.hostname.endsWith('zurisell.store') && !document.cookie.includes('zuri_src=')) {
          var q = new URLSearchParams(location.search), r = ''
          try { r = document.referrer ? new URL(document.referrer).hostname : '' } catch (e) {}
          if (r.endsWith('zurisell.store')) r = ''
          var src = { s: q.get('utm_source') || '', m: q.get('utm_medium') || '', c: q.get('utm_campaign') || '', r: r, l: location.pathname, t: new Date().toISOString().slice(0, 10) }
          document.cookie = 'zuri_src=' + encodeURIComponent(JSON.stringify(src)) + ';domain=.zurisell.store;path=/;max-age=7776000;samesite=lax;secure'
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">{T.skip}</a>
    <PromoBar lang={lang} href={signupUrl} />
    <header class="mk-header">
      <div class="mk-wrap mk-header-row">
        <a class="mk-logo" href={home} aria-label="Zuri">
          <span class="mk-logo-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28"><rect width="32" height="32" rx="9" fill="#f59e0b"></rect><path d="M10.5 10.5h11l-11 11h11" fill="none" stroke="#1c1917" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </span>
          Zuri
        </a>
        <nav class="mk-nav" aria-label="Navigation">
          <a href={`${home === '/' ? '' : home}/#comment`}>{T.how}</a>
          <a href={PATHS.guides[lang]}>{T.guides}</a>
          <a href={PATHS.countries[lang]}>{T.countries}</a>
          <a href={PATHS.features[lang]}>{T.featuresPage}</a>
          <a href={PATHS.help[lang]}>{T.help}</a>
          <a href={contactPath}>{T.contact}</a>
        </nav>
        <div class="mk-header-cta">
          <a class="mk-link" href={otherPath} hreflang={other} lang={other}>{T.langLabel}</a>
          <a class="mk-link" href={loginUrl}>{T.login}</a>
          <a class="mk-btn mk-btn-sm" href={signupUrl}>{T.signup}</a>
        </div>
      </div>
    </header>

    {
      breadcrumbs.length > 0 && (
        <nav class="mk-crumbs mk-wrap" aria-label="Fil d’Ariane">
          <a href={home}>{T.home}</a>
          {breadcrumbs.map((c) => (
            <>
              <span aria-hidden="true">/</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }

    <main id="contenu">
      <slot />
    </main>

    <footer class="mk-footer">
      <div class="mk-wrap mk-footer-grid mk-footer-grid-wide">
        <div>
          <a class="mk-logo" href={home}>
            <span class="mk-logo-mark" aria-hidden="true">
              <svg viewBox="0 0 32 32" width="24" height="24"><rect width="32" height="32" rx="9" fill="#f59e0b"></rect><path d="M10.5 10.5h11l-11 11h11" fill="none" stroke="#1c1917" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            Zuri
          </a>
          <p class="mk-footer-tag">{T.tagline}</p>
          <p class="mk-footer-tag"><a href={otherPath} hreflang={other} lang={other}>{T.langLabel}</a></p>
        </div>
        <nav aria-label={T.product}>
          <p class="mk-footer-title">{T.product}</p>
          <a href={`${home === '/' ? '' : home}/#comment`}>{T.how}</a>
          <a href={PATHS.features[lang]}>{T.featuresPage}</a>
          <a href={PATHS.help[lang]}>{T.help}</a>
          <a href={PATHS.changelog[lang]}>{T.changelog}</a>
          <a href={lang === 'fr' ? '/tarifs' : '/en/pricing'}>{T.pricing}</a>
          <a href={lang === 'fr' ? '/a-propos' : '/en/about'}>{T.about}</a>
          <a href={contactPath}>{T.contact}</a>
          <a href={`${home === '/' ? '' : home}/#faq`}>{T.faq}</a>
          <a href={signupUrl}>{T.signup}</a>
          <a href={loginUrl}>{T.login}</a>
        </nav>
        <nav aria-label={T.resources}>
          <p class="mk-footer-title">{T.resources}</p>
          <a href={PATHS.guides[lang]}>{T.guides}</a>
          <a href={PATHS.countries[lang]}>{T.countries}</a>
          <a href={PATHS.alternatives[lang]}>{T.alternatives}</a>
          <a href={PATHS.comparisons[lang]}>{T.compare}</a>
          <a href={PATHS.tools[lang]}>{T.tools}</a>
          <a href={PATHS.niches[lang]}>{T.niches}</a>
          <a href={PATHS.cities[lang]}>{T.cities}</a>
          <a href={PATHS.best[lang]}>{T.best}</a>
        </nav>
        <nav aria-label={T.countries}>
          <p class="mk-footer-title">{T.countries}</p>
          {footerCountries.map((c) => <a href={countryPath(c.slug, lang)}>{t(c.name, lang)}</a>)}
          <a href={PATHS.countries[lang]}>{T.allCountries}</a>
        </nav>
        <nav aria-label={T.popular}>
          <p class="mk-footer-title">{T.popular}</p>
          {footerGuides.map((g) => <a href={guidePath(g.slug[lang], lang)}>{t(g.h1, lang)}</a>)}
        </nav>
      </div>
      <div class="mk-wrap mk-footer-bottom">© {new Date().getFullYear()} Zuri. {T.bottom} <a href={`mailto:${contact.email}`}>{contact.email}</a>{(contact.socials ?? []).map((u) => <> · <a href={u} rel="me noopener" target="_blank">{(() => { try { return new URL(u).hostname.replace(/^www\./, '').split('.')[0] } catch { return u } })()}</a></>)}</div>
    </footer>
    {
      contact.whatsapp && (
        <a class="mk-wa-float" href={waLink(contact.whatsapp, T.waMsg)} target="_blank" rel="noopener" aria-label={T.waFloat} data-umami-event="whatsapp-flottant">
          <Icon name="message" size={22} />
          <span>{T.waFloat}</span>
        </a>
      )
    }
    <script is:inline>
      /* Événements Umami : clics vers l'inscription (avec la page d'origine). */
      document.querySelectorAll('a[href*="/register"]').forEach(function (a) {
        a.setAttribute('data-umami-event', 'clic-inscription')
        a.setAttribute('data-umami-event-page', location.pathname)
      })
      /* Événements Umami : outils, illustrations interactives, vidéos (une fois par élément). */
      ;(function () {
        var seen = new WeakSet()
        var track = function (name, data) { try { window.umami && window.umami.track(name, data) } catch (e) {} }
        var onUse = function (e) {
          var t = e.target
          if (!(t instanceof Element)) return
          var tool = t.closest('.mk-tool')
          if (tool && !seen.has(tool)) { seen.add(tool); track('outil-utilise', { outil: tool.getAttribute('data-tool'), page: location.pathname }) }
          var w = t.closest('[data-w]')
          if (w && !seen.has(w) && w.querySelector('input,button')) { seen.add(w); var ti = w.querySelector('.mk-w-title'); track('illustration-utilisee', { titre: ti ? ti.textContent : '', page: location.pathname }) }
          var v = t.closest('[data-yt]')
          if (v && !seen.has(v)) { seen.add(v); track('video-lancee', { video: v.getAttribute('data-yt'), page: location.pathname }) }
        }
        document.addEventListener('input', onUse, true)
        document.addEventListener('click', onUse, true)
      })()
      /* Lien d'inscription : page d'origine transmise pour la provenance. */
      document.querySelectorAll('a[href*="/register"]').forEach(function (a) {
        try { var u = new URL(a.href); u.searchParams.set('from', location.pathname); a.href = u.toString() } catch (e) {}
      })
    </script>
  </body>
</html>
