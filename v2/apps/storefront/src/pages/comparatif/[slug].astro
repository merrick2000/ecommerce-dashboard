---
import ComparisonView from '../../components/marketing/views/ComparisonView.astro'
import { findComparison, comparisonPath, resolveSlug } from '../../content/seo'
export const prerender = false
// Adresse alignée sur le titre ; l'ancienne adresse (clé) redirige en 301.
const { key, legacy } = resolveSlug('comparisons', Astro.params.slug ?? '', 'fr')
const item = findComparison(key)
if (!item) return Astro.rewrite('/404')
if (legacy) return Astro.redirect(comparisonPath(item.slug, 'fr') + Astro.url.search, 301)
---

<ComparisonView cmp={item} lang="fr" />
