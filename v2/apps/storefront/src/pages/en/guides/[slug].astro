---
import GuideView from '../../../components/marketing/views/GuideView.astro'
import { findGuide, guidePath, resolveSlug } from '../../../content/seo'
export const prerender = false
// Adresse alignée sur le titre ; l'ancienne adresse (clé) redirige en 301.
const { key, legacy } = resolveSlug('guides', Astro.params.slug ?? '', 'en')
const item = findGuide(key, 'en')
if (!item) return Astro.rewrite('/404')
if (legacy) return Astro.redirect(guidePath(item.slug.en, 'en') + Astro.url.search, 301)
---

<GuideView guide={item} lang="en" />
