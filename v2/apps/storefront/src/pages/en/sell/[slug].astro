---
import NicheView from '../../../components/marketing/views/NicheView.astro'
import { findNiche, nichePath, resolveSlug } from '../../../content/seo'
export const prerender = false
// Adresse alignée sur le titre ; l'ancienne adresse (clé) redirige en 301.
const { key, legacy } = resolveSlug('niches', Astro.params.slug ?? '', 'en')
const item = findNiche(key, 'en')
if (!item) return Astro.rewrite('/404')
if (legacy) return Astro.redirect(nichePath(item.slug.en, 'en') + Astro.url.search, 301)
---

<NicheView niche={item} lang="en" />
