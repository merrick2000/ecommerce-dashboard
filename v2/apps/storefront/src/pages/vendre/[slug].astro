---
import NicheView from '../../components/marketing/views/NicheView.astro'
import ComboView from '../../components/marketing/views/ComboView.astro'
import { findCombo, findNiche, nichePath, resolveSlug } from '../../content/seo'
export const prerender = false
// Adresse alignée sur le titre ; l'ancienne adresse (clé) redirige en 301.
// D'abord un métier (inchangé), sinon une combinaison métier × ville, sinon 404.
const param = Astro.params.slug ?? ''
const { key, legacy } = resolveSlug('niches', param, 'fr')
const item = findNiche(key, 'fr')
const combo = item ? undefined : findCombo(resolveSlug('combos', param, 'fr').key)
if (!item && !combo) return Astro.rewrite('/404')
if (item && legacy) return Astro.redirect(nichePath(item.slug.fr, 'fr') + Astro.url.search, 301)
---

{item ? <NicheView niche={item} lang="fr" /> : <ComboView combo={combo!} lang="fr" />}
