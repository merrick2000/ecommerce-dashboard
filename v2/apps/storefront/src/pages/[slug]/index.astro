---
/** Catalogue de la boutique : filtres par catégorie (liens, sans JS), ajout au panier si le vendeur l'a activé. */
import Footer from '../../components/Footer.astro'
import Layout from '../../components/Layout.astro'
import PausedNotice from '../../components/sales/PausedNotice.astro'
import CartDrawer from '../../islands/CartDrawer'
import { ApiError, apiGet } from '../../lib/api'
import { jsonForScript } from '../../lib/content'
import { money } from '../../lib/format'
import { dict } from '../../lib/i18n'
import type { CatalogData } from '../../lib/types'
import { absoluteUrl, img, storeUrl } from '../../lib/urls'
import { storeJsonLd } from '../../lib/structured'

export const prerender = false

const { slug = '' } = Astro.params
let d: CatalogData
try {
  d = await apiGet<CatalogData>(`/stores/${encodeURIComponent(slug)}`)
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 410)) return Astro.rewrite('/404')
  throw e
}
const { store, products } = d
const t = dict(store.locale)
const cache = 'public, s-maxage=30, stale-while-revalidate=300'
Astro.response.headers.set('Cache-Control', cache)
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', cache)
const trackCfg = { storeId: store.id, productId: null, fb: null, tt: null }

const categories = [...new Set(products.map((p) => p.category).filter((c): c is string => !!c))].sort((a, b) => a.localeCompare(b, store.locale))
const current = Astro.url.searchParams.get('cat')
const shown = current ? products.filter((p) => p.category === current) : products
// Sans filtre et avec des catégories : produits regroupés par catégorie (les autres à la fin).
const groups: { title: string | null; items: typeof products }[] =
  !current && categories.length
    ? [...categories.map((c) => ({ title: c, items: products.filter((p) => p.category === c) })), { title: null, items: products.filter((p) => !p.category) }].filter((g) => g.items.length)
    : [{ title: null, items: shown }]
const cart = Boolean(d.cartEnabled)
// La boutique et ses produits en données structurées (moteurs, IA, comparateurs).
const storeLd = storeJsonLd(store, absoluteUrl(Astro.locals, '/'), products.map((p) => ({ name: p.name, url: absoluteUrl(Astro.locals, `/p/${p.id}`), image: p.thumbnail, price: p.price.effective, currency: p.price.currency })))
const catUrl = (c: string | null) => storeUrl(Astro.locals, c ? `/?cat=${encodeURIComponent(c)}` : '/')
---

<Layout title={current ? `${current} | ${store.name}` : store.name} description={`${store.name} | ${t.catalog.products}`} lang={store.locale} canonical={absoluteUrl(Astro.locals, '/')} ogImage={products[0]?.thumbnail} primaryColor={d.primaryColor}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonForScript(storeLd)} />
    <link rel="alternate" type="application/rss+xml" title={`${store.name} (catalogue)`} href={absoluteUrl(Astro.locals, '/feeds/google.xml')} />
  </Fragment>
  <header class="top">
    <div class="wrap wrap-wide"><a href={storeUrl(Astro.locals, '/')}>{store.name}</a></div>
  </header>
  <main class="wrap wrap-wide">
    {store.status === 'paused' && <div style="margin:12px 0"><PausedNotice message={store.pauseMessage} locale={store.locale} /></div>}
    <h1 class="sr-only">{store.name}</h1>
    {
      categories.length > 0 && (
        <nav class="cats" aria-label={t.catalog.products}>
          <a href={catUrl(null)} aria-current={!current ? 'page' : undefined}>{t.catalog.all}</a>
          {categories.map((c) => (
            <a href={catUrl(c)} aria-current={current === c ? 'page' : undefined}>{c}</a>
          ))}
        </nav>
      )
    }
    {
      products.length === 0 ? (
        <p class="msg muted">{t.catalog.empty}</p>
      ) : (
        groups.map((g, gi) => (
          <section>
            {g.title && <h2 class="cat-title">{g.title}</h2>}
            <div class="grid">
              {g.items.map((p, i) => (
                <div class="card">
                  <a href={storeUrl(Astro.locals, `/p/${p.id}`)} style="display:block;color:inherit;text-decoration:none">
                    {p.thumbnail ? <img src={img(p.thumbnail, 400)} alt="" width="400" height="400" loading={gi === 0 && i < 2 ? 'eager' : 'lazy'} decoding="async" /> : <div class="ph" />}
                    <div class="card-b">
                      <p class="card-n">{p.name}</p>
                      <span class="card-p">
                        {money(p.price.effective, p.price.currency, store.locale)}
                        {p.price.regular > p.price.effective && <s>{money(p.price.regular, p.price.currency, store.locale)}</s>}
                      </span>
                    </div>
                  </a>
                  {cart &&
                    (p.hasVariants ? (
                      <a class="btn btn-ghost card-add" style="display:flex" href={storeUrl(Astro.locals, `/p/${p.id}`)}>{t.catalog.choose}</a>
                    ) : (
                      <button type="button" class="btn card-add" style="display:flex;width:calc(100% - 24px)" data-cart-add={p.id}>{t.cart.add}</button>
                    ))}
                </div>
              ))}
            </div>
          </section>
        ))
      )
    }
  </main>
  {cart && <CartDrawer client:idle storeId={store.id} slug={store.slug} locale={store.locale} productBase={storeUrl(Astro.locals, '/p/')} t={t.cart} />}
  <Footer store={store} />
  <script is:inline type="application/json" id="sf-track" set:html={jsonForScript(trackCfg)} />
  <script is:inline type="application/json" id="sf-cart-cfg" set:html={jsonForScript({ storeId: store.id, added: t.cart.added, add: t.cart.add })} />
  <script>
    import { startTracking } from '../../client/track'
    import { addToCart } from '../../client/cart'
    startTracking()
    const cfg = JSON.parse(document.getElementById('sf-cart-cfg')?.textContent || '{}') as { storeId: string; added: string; add: string }
    document.querySelectorAll<HTMLButtonElement>('[data-cart-add]').forEach((b) => {
      b.addEventListener('click', () => {
        addToCart(cfg.storeId, { productId: b.dataset.cartAdd!, variantId: null, quantity: 1 })
        window.dispatchEvent(new CustomEvent('sf-cart', { detail: { storeId: cfg.storeId, open: true } }))
        b.textContent = cfg.added
        setTimeout(() => (b.textContent = cfg.add), 1500)
      })
    })
  </script>
</Layout>
