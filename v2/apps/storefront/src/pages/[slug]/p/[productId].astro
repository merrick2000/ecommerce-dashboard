---
/** Page de vente, HTML d'abord, mise en cache (aucune donnée personnelle ici). */
import Footer from '../../../components/Footer.astro'
import Layout from '../../../components/Layout.astro'
import Block from '../../../components/sales/Block.astro'
import OrderBox from '../../../components/sales/OrderBox.astro'
import PausedNotice from '../../../components/sales/PausedNotice.astro'
import CustomPage from '../../../components/sales/CustomPage.astro'
import CartDrawer from '../../../islands/CartDrawer'
import { ApiError, apiGet } from '../../../lib/api'
import { excerpt, jsonForScript, waLink } from '../../../lib/content'
import { money } from '../../../lib/format'
import { dict } from '../../../lib/i18n'
import type { CheckoutData } from '../../../lib/types'
import { absoluteUrl, canonicalRedirect, canonicalStoreUrl, img, originOf, storeUrl } from '../../../lib/urls'
import { breadcrumbJsonLd, productJsonLd } from '../../../lib/structured'
import { STICKY_CTA_DEFAULTS } from '@zuri/shared'
import { interpolate } from '@zuri/shared/form-runtime'

export const prerender = false

const { slug = '', productId = '' } = Astro.params
// Identifiant public (prd_…) ou ancien numéro de Sellit v1 (/p/123, liens de pub).
if (!/^(prd_[0-9A-Za-z]{8,32}|\d{1,10})$/.test(productId)) return Astro.rewrite('/404')

// Aperçu (route /p/:id/preview) : jeton signé du tableau de bord, produit actif ou non.
const previewToken = Astro.url.searchParams.get('preview')
let d: CheckoutData
try {
  d = await apiGet<CheckoutData>(`/checkout/${encodeURIComponent(slug)}/${productId}${previewToken ? `?preview=${encodeURIComponent(previewToken)}` : ''}`)
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 410 || e.status === 422)) return Astro.rewrite('/404')
  throw e
}

const { store, product, checkout, zones, tracking } = d
// Ancien lien numérique : redirection permanente vers l'adresse définitive (les pubs gardent leur trafic).
if (product.id !== productId) return Astro.redirect(storeUrl(Astro.locals, `/p/${product.id}`) + Astro.url.search, 301)
// Une seule adresse par produit (guide Google, contenu dupliqué) : zurisell.store/boutique/p/… redirige vers l'adresse officielle.
if (!d.preview) {
  const to = canonicalRedirect(Astro.locals, store, `/p/${product.id}`, Astro.url.search)
  if (to) return Astro.redirect(to, 301)
}
const T = dict(store.locale)
const t = T.page
const isCod = product.payment.method === 'cod'
const price = product.price
const m = (n: number) => money(n, price.currency, store.locale)
const blocks = checkout.pageLayout.filter((b) => b.visible).map((b) => b.block)
// Mise en page sur ordinateur (sur mobile, tout est sur une colonne).
const layout = checkout.desktopLayout ?? 'form_side'
const titleAbove = layout === 'product_split' && checkout.titlePosition === 'above'
const SPLIT_TOP: string[] = ['hero_image', 'product_name', 'price_cta']
const ctaLabel = isCod ? t.orderCod : checkout.ctaText
// Bouton collant : réglages de la boutique (valeurs par défaut fournies par l'API).
const sticky = { ...STICKY_CTA_DEFAULTS, ...checkout.stickyCta }
const stickyText = sticky.text.trim()
  ? interpolate(sticky.text, { produit: product.name, prix: m(price.effective), prix_barre: price.regular > price.effective ? m(price.regular) : '', boutique: store.name })
  : isCod
    ? t.buyNow
    : ctaLabel
const wa = product.content.whatsapp
const waHref = wa?.enabled && wa.phone ? waLink(wa.phone, wa.welcomeMessage || t.whatsappMessage(product.name)) : null
const description = excerpt(product.description) || excerpt(product.content.customText ?? '') || product.name

const isPreview = Boolean(d.preview)
const cache = isPreview ? 'private, no-store' : 'public, s-maxage=30, stale-while-revalidate=300'
Astro.response.headers.set('Cache-Control', cache)
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', isPreview ? 'no-store' : cache)
if (isPreview) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')

// Page HTML libre du vendeur : remplace le modèle (le formulaire, le suivi et les pixels restent ceux de Zuri).
const custom = product.content.customPage?.enabled && product.content.customPage.html ? product.content.customPage : null
// Données produit standard (schema.org, balises produit Open Graph) : générées depuis la fiche, rien à remplir.
const pageUrl = canonicalStoreUrl(Astro.locals, store, `/p/${product.id}`)
const homeUrl = canonicalStoreUrl(Astro.locals, store, '/')
const shipByCountry = new Map<string, number>()
for (const z of zones) shipByCountry.set((z.country || store.country).toUpperCase(), Math.min(shipByCountry.get((z.country || store.country).toUpperCase()) ?? Infinity, Number(z.fee)))
const shipping = product.type === 'digital' ? [{ country: store.country.toUpperCase(), price: 0 }] : [...shipByCountry].map(([country, price]) => ({ country, price }))
const ld = [
  productJsonLd(d, { url: pageUrl, storeUrl: homeUrl, shipping }),
  breadcrumbJsonLd([
    { name: store.name, url: homeUrl },
    { name: product.name, url: pageUrl },
  ]),
  ...((product.content.faqs ?? []).filter((f) => f.question && f.answer).length
    ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: product.content.faqs.filter((f) => f.question && f.answer).map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) }]
    : []),
]
// Aperçu : ni pixels, ni statistiques (le paramètre notrack coupe aussi tout le suivi côté navigateur).
const trackCfg = { storeId: store.id, productId: product.id, fb: isPreview ? null : tracking.facebookPixelId, tt: isPreview ? null : tracking.tiktokPixelId, value: price.effective, currency: price.currency, name: product.name, ...(isPreview ? { preview: true } : {}) }
---

<Layout
  title={`${product.name} | ${store.name}`}
  description={description}
  lang={store.locale}
  canonical={pageUrl}
  ogImage={product.coverImage}
  ogType="product"
  noindex={isPreview}
  template={checkout.template}
  primaryColor={checkout.primaryColor}
  preconnect={[originOf(product.coverImage)]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonForScript(ld)} />
    <meta property="product:price:amount" content={String(price.regular)} />
    <meta property="product:price:currency" content={price.currency} />
    <meta property="product:availability" content={product.inStock ? 'in stock' : 'out of stock'} />
    <meta property="product:condition" content="new" />
    <meta property="product:retailer_item_id" content={product.sku ?? product.id} />
    <meta property="product:brand" content={store.name} />
    {price.regular > price.effective && <meta property="product:sale_price:amount" content={String(price.effective)} />}
    {price.regular > price.effective && <meta property="product:sale_price:currency" content={price.currency} />}
    <meta property="og:site_name" content={store.name} />
  </Fragment>
  {
    custom && (
      <Fragment slot="head">
        {custom.fonts.map((f) => <link rel="stylesheet" href={f} />)}
        {custom.tailwind && <script is:inline src="https://cdn.tailwindcss.com" />}
        {custom.css && <style is:inline set:html={custom.css} />}
      </Fragment>
    )
  }
  {
    isPreview && (
      <div role="status" style="position:sticky;top:0;z-index:60;background:#18181b;color:#fff;font:600 13px/1.4 system-ui,sans-serif;text-align:center;padding:8px 12px">
        {store.locale === 'en' ? 'Preview: this is what your customers will see.' : 'Aperçu : voici ce que verront vos clients.'}
        {product.isActive === false && (store.locale === 'en' ? ' This product is not on sale yet.' : ' Ce produit n’est pas encore en vente.')}
        {store.locale === 'en' ? ' No order is created, nothing is counted in your stats.' : ' Aucune commande n’est créée, rien n’est compté dans vos statistiques.'}
      </div>
    )
  }
  <div id="sf-promo" class="promo-bar" role="status" hidden></div>

  {
    custom ? (
      <CustomPage d={d} orderBase={storeUrl(Astro.locals, '/order/')} ctaLabel={ctaLabel} waHref={waHref} />
    ) : layout === 'product_split' ? (
      // Style boutique : image à gauche ; titre, prix et formulaire à droite ; le reste en dessous.
      <div class={`sales sales-split${titleAbove ? ' title-above' : ''}`}>
        {titleAbove && blocks.includes('product_name') && (
          <div class="split-head">
            <Block block="product_name" d={d} />
          </div>
        )}
        <div class="split-media">{blocks.includes('hero_image') && <Block block="hero_image" d={d} />}</div>
        <div class="split-buy">
          {!titleAbove && blocks.includes('product_name') && <Block block="product_name" d={d} />}
          {blocks.includes('price_cta') && <Block block="price_cta" d={d} inline />}
          <section class="split-order" id="commander" aria-label={t.orderTitle}>
            {store.status === 'paused' ? <PausedNotice message={store.pauseMessage} locale={store.locale} /> : <OrderBox d={d} orderBase={storeUrl(Astro.locals, '/order/')} compact />}
          </section>
        </div>
        <main class="split-rest">
          {blocks.filter((b) => !SPLIT_TOP.includes(b)).map((b) => <Block block={b} d={d} />)}
        </main>
      </div>
    ) : (
      <div class={`sales${layout === 'single' ? ' sales-single' : ''}`}>
        <main class="sales-main">
          {blocks.map((b) => <Block block={b} d={d} />)}
        </main>

        <aside class="sales-aside" id="commander" aria-label={t.orderTitle}>
          {store.status === 'paused' ? <PausedNotice message={store.pauseMessage} locale={store.locale} /> : <OrderBox d={d} orderBase={storeUrl(Astro.locals, '/order/')} />}
        </aside>
      </div>
    )
  }

  {checkout.cart?.enabled && <CartDrawer client:idle storeId={store.id} slug={store.slug} locale={store.locale} productBase={storeUrl(Astro.locals, '/p/')} t={T.cart} />}
  <Footer store={store} />

  {
    product.inStock && sticky.enabled && (
      <div
        id="sf-sticky"
        class={`sticky${sticky.position === 'top' ? ' sticky-top' : ''}${sticky.devices === 'all' ? ' sticky-all' : ''}${sticky.animation !== 'none' ? ` anim-${sticky.animation}` : ''}`}
        aria-hidden="true"
        data-trigger={sticky.trigger}
        data-percent={sticky.scrollPercent}
        data-hide-near-form={sticky.hideNearForm ? '1' : '0'}
      >
        {sticky.showThumbnail && (product.thumbnail ?? product.coverImage) && <img class="s-thumb" src={img(product.thumbnail ?? product.coverImage, 96)} alt="" width="44" height="44" loading="lazy" decoding="async" />}
        {sticky.showPrice && (
          <div class="s-price">
            {price.regular > price.effective && <s>{m(price.regular)}</s>}
            {m(price.effective)}
          </div>
        )}
        <a class={`btn cta-${checkout.ctaStyle === 'large' ? 'default' : checkout.ctaStyle}`} href="#commander" data-cta="sticky">
          {stickyText}
        </a>
      </div>
    )
  }

  {
    waHref && (
      <a class={`wa${wa.position === 'left' ? ' wa-left' : ''}`} href={waHref} target="_blank" rel="noopener" data-wa aria-label={t.whatsapp} title={t.whatsapp}>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1l-.9 1.2c-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.7.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4C2.7 15.6 2.2 13.8 2.2 12 2.2 6.6 6.6 2.2 12 2.2c2.6 0 5.1 1 6.9 2.9 1.8 1.8 2.9 4.3 2.9 6.9 0 5.4-4.4 9.8-9.8 9.8zm8.3-18.1C18.1 1.5 15.1.2 12 .2 5.5.2.2 5.5.2 12c0 2.1.5 4.1 1.6 5.9L.1 24l6.3-1.6c1.7.9 3.7 1.4 5.6 1.4 6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.5-8.3z" />
        </svg>
      </a>
    )
  }

  {
    checkout.salesPopup?.enabled && (
      <div id="sf-popup" class="popup" role="status" aria-live="polite" data-slug={store.slug} data-interval={checkout.salesPopup.intervalSeconds} data-bought={t.justBought} data-from={t.from} data-ago={JSON.stringify(t.ago)} data-template={checkout.salesPopup.template ?? ''} data-recent={checkout.salesPopup.recentLabel || (store.locale === 'en' ? 'recently' : 'récemment')} />
    )
  }

  <script is:inline type="application/json" id="sf-track" set:html={jsonForScript(trackCfg)} />
  <script>
    import '../../../client/page'
  </script>
</Layout>
