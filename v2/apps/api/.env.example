DATABASE_URL=postgres://sellit:sellit@127.0.0.1:5440/sellit
PORT=8787
# 32 octets en base64 : openssl rand -base64 32
APP_KEY=
# URL publique du dashboard (cookies, liens) et du storefront (liens clients)
APP_URL=http://localhost:5173
STOREFRONT_URL=http://localhost:3000
BASE_DOMAIN=zurisell.store
# Stockage S3-compatible
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Notifications
RESEND_API_KEY=
MAIL_FROM=Zuri <noreply@example.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Base Laravel à importer (bun run import:legacy)
LEGACY_DATABASE_URL=

# Secret partagé avec le Worker Cloudflare (openssl rand -base64 32). Vide en local.
# true = inscriptions ouvertes à d autres vendeurs (multi-boutiques SaaS)
REGISTRATION_OPEN=false
# EDGE_SECRET=
# Connexion Google : console.cloud.google.com → Identifiants → ID client OAuth (Application Web)
# URI de redirection autorisée : {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
