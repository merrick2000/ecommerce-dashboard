{
  "name": "@zuri/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "typecheck": "tsc -p .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "import:legacy": "bun src/db/import-legacy.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@zuri/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pg-boss": "^12.38.2",
    "postgres": "^4.1.1",
    "sanitize-html": "^2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
